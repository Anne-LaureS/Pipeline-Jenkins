pipeline {
    agent { label 'aws-lab' }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        string(name: 'OPERATOR_IP', defaultValue: '', description: 'Ton IP publique actuelle (https://checkip.amazonaws.com) — pour accéder à GLPI:8080 depuis ton navigateur. Obligatoire.')
    }

    environment {
        AWS_DEFAULT_REGION = 'eu-west-3'
    }

    stages {
        stage('Validation des paramètres') {
            steps {
                script {
                    if (!params.OPERATOR_IP?.trim()) {
                        error('OPERATOR_IP est obligatoire (ton IP publique, sans /32).')
                    }
                }
            }
        }

        stage('Provisionner (ou réutiliser) la machine app') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-jenkins-lab', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        export OPERATOR_IP="${OPERATOR_IP}"
                        chmod +x TP_7/projet-groupe/provision-app-ec2.sh
                        TP_7/projet-groupe/provision-app-ec2.sh
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'TP_7/projet-groupe/inventory/hosts.ini', fingerprint: true, allowEmptyArchive: true
            echo "Provisioning ${env.BUILD_NUMBER} terminé avec le statut : ${currentBuild.currentResult}"
        }
    }
}
